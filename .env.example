# Copy this file to .env and fill in real values. Never commit .env.

# Which VLM provider to use (currently available: gemini)
VLM_PROVIDER=gemini

# Model name for that provider. Leave empty to use the provider's default
# (gemini -> gemini-3.8-flash).
VLM_MODEL=gemini-3.5-flash-lite

# Gemini thinking level: minimal | low | medium | high (empty = low).
# gemini-3.8-flash rejects "minimal"; gemini-3.5-flash-lite supports it.
GEMINI_THINKING_LEVEL=minimal

# Seconds before a VLM request is abandoned
VLM_TIMEOUT=90

# --- Provider API keys (only the selected provider's key is needed) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
